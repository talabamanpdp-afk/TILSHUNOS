# Tilshunos Platform - Environment Variables Template

# Database
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=tilshunos_db;Username=postgres;Password=your_password_here;"

# Security & JWT
Jwt__SecretKey="your_secure_256_bit_secret_key_minimum_32_characters"
Jwt__Issuer="Tilshunos"
Jwt__Audience="TilshunosLearners"
Jwt__ExpirationHours=72

# Resend Transactional Email
Resend__ApiKey="re_your_live_resend_api_key"
Resend__FromEmail="support@yourdomain.com"

# AI Provider (OpenRouter / OpenAI / Google Gemini)
AI__ApiKey="your_ai_provider_api_key"
AI__Endpoint="https://openrouter.ai/api/v1/chat/completions"
AI__Model="google/gemini-2.0-flash-001"

# Frontend & CORS
FrontendUrl="http://localhost:3000"
ASPNETCORE_ENVIRONMENT="Development"
